<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluxDisplay.App.Controls">

    <Color x:Key="FluxDeepColor">#081827</Color>
    <Color x:Key="FluxCardColor">#102438</Color>
    <Color x:Key="FluxHeaderStartColor">#071A2F</Color>
    <Color x:Key="FluxHeaderEndColor">#0A2540</Color>
    <Color x:Key="FluxActiveColor">#1C7E36</Color>

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource FluxDeepColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource FluxCardColor}" />
    <SolidColorBrush x:Key="ActiveBadgeBrush" Color="{StaticResource FluxActiveColor}" />

    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource FluxHeaderStartColor}" Offset="0" />
        <GradientStop Color="{StaticResource FluxHeaderEndColor}" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="FluxCardBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="FluxPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="FluxMutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="controls:TrayPresetMenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinWidth" Value="260" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:TrayPresetMenuItem">
                    <Grid
                        x:Name="LayoutRoot"
                        Background="{TemplateBinding Background}"
                        MinWidth="{TemplateBinding MinWidth}"
                        Padding="12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox
                            Width="16"
                            Height="16"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                            <ContentPresenter Content="{TemplateBinding Icon}" />
                        </Viewbox>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock
                                Text="{TemplateBinding Text}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#E8EEF5"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{TemplateBinding Subtitle}"
                                FontSize="12"
                                Foreground="#8BA0B8"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="#22FFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="#33FFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
