<Window x:Class="FluxDisplay.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
  <Grid Background="{StaticResource PageBackgroundBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Padding="20,28" Spacing="14" Background="#0B1C2D">
      <TextBlock Text="▣  Display Presets" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <Button Content="Presets" HorizontalContentAlignment="Left" Padding="14,10" Background="#123A60"/>
      <Button Content="⚙  Settings" HorizontalContentAlignment="Left" Padding="14,10" Background="Transparent"/>
      <Border VerticalAlignment="Bottom" Margin="0,420,0,0"><TextBlock Text="●  Running in tray" Foreground="#46D6A0" FontSize="12"/></Border>
    </StackPanel>
    <Grid Grid.Column="1" Padding="42">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24"><TextBlock Text="Your presets" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="＋  Add preset" Background="#1687F7" Padding="18,10"/></Grid>
      <StackPanel Grid.Row="1" Spacing="14">
        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="#1E4D79" BorderThickness="1" CornerRadius="10" Padding="18">
          <Grid ColumnDefinitions="100,*,Auto"><Border Width="84" Height="56" Background="#172E45" CornerRadius="6"><TextBlock Text="▰" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#3B9DFF"/></Border><StackPanel Grid.Column="1" Margin="18,0"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Gaming 1080p" FontSize="17" FontWeight="SemiBold"/><Border Background="#1C7E36" CornerRadius="10" Padding="8,2"><TextBlock Text="Active" FontSize="11"/></Border></StackPanel><TextBlock Text="Monitor 1  ·  1920 × 1080  ·  240 Hz  ·  100%" Opacity="0.7" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="2" Content="Apply" Background="#1687F7" Padding="18,8" VerticalAlignment="Center"/></Grid>
        </Border>
        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="18"><Grid ColumnDefinitions="100,*,Auto"><Border Width="84" Height="56" Background="#172E45" CornerRadius="6"><TextBlock Text="▰" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#3B9DFF"/></Border><StackPanel Grid.Column="1" Margin="18,0"><TextBlock Text="Work 1440p" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Monitor 1  ·  2560 × 1440  ·  144 Hz  ·  125%" Opacity="0.7" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="2" Content="Apply" Padding="18,8" VerticalAlignment="Center"/></Grid></Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
