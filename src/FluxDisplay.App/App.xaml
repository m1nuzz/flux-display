<Application
    x:Class="FluxDisplay.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:FluxDisplay.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
                <ResourceDictionary Source="Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#081827" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#102438" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:StepVisibilityConverter x:Key="StepZeroConverter" Step="0" />
            <converters:StepVisibilityConverter x:Key="StepOneConverter" Step="1" />
            <converters:StepVisibilityConverter x:Key="StepTwoConverter" Step="2" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
