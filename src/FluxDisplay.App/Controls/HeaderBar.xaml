<UserControl
    x:Class="FluxDisplay.App.Controls.HeaderBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24,16" Background="{StaticResource HeaderGradientBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="Display Presets" FontSize="22" FontWeight="SemiBold" />
            <TextBlock
                Text="Quickly switch resolution, refresh rate and DPI"
                Style="{StaticResource FluxMutedTextStyle}"
                Margin="0,4,0,0" />
        </StackPanel>
        <Border
            Grid.Column="1"
            Background="#1AFFFFFF"
            CornerRadius="12"
            Padding="12,6"
            VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE770;" FontSize="14" />
                <TextBlock Text="WinUI 3 Native.Fast.Minimal" FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
