<Page
    x:Class="FluxDisplay.App.Views.CreatePresetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluxDisplay.App.Controls"
    xmlns:models="using:FluxDisplay.App.Models"
    x:Name="RootPage">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:StepperHeader />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <StackPanel Spacing="8" Visibility="{Binding CurrentStep, Converter={StaticResource StepZeroConverter}}">
                    <HyperlinkButton Content="Identify displays" Command="{Binding IdentifyCommand}" />
                    <TextBlock Text="Select one or more monitors." Style="{StaticResource FluxMutedTextStyle}" />
                    <ItemsRepeater ItemsSource="{Binding Monitors}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="280" MinItemHeight="140" MinColumnSpacing="12" MinRowSpacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:MonitorOption">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0"
                                    Command="{Binding DataContext.SelectMonitorCommand, ElementName=RootPage}"
                                    CommandParameter="{Binding}">
                                    <controls:MonitorPickerCard DataContext="{Binding}" />
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <ItemsRepeater
                    ItemsSource="{Binding TargetDrafts}"
                    Visibility="{Binding CurrentStep, Converter={StaticResource StepOneConverter}}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:MonitorSettingsDraft">
                            <Border Style="{StaticResource FluxCardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ComboBox
                                        Header="Resolution"
                                        MinWidth="280"
                                        HorizontalAlignment="Left"
                                        ItemsSource="{Binding Resolutions}"
                                        SelectedItem="{Binding SelectedResolution, Mode=TwoWay}" />
                                    <ComboBox
                                        Header="Refresh rate"
                                        MinWidth="280"
                                        HorizontalAlignment="Left"
                                        ItemsSource="{Binding RefreshRates}"
                                        SelectedItem="{Binding SelectedRefreshRate, Mode=TwoWay}" />
                                    <ComboBox
                                        Header="Scaling"
                                        MinWidth="280"
                                        HorizontalAlignment="Left"
                                        ItemsSource="{Binding ScaleOptions}"
                                        SelectedItem="{Binding ScalePercent, Mode=TwoWay}" />
                                    <TextBox Header="DPI" IsReadOnly="True" MinWidth="280" Text="{Binding CurrentDpi}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <StackPanel Spacing="12" Visibility="{Binding CurrentStep, Converter={StaticResource StepTwoConverter}}">
                    <Border
                        Style="{StaticResource FluxCardBorderStyle}"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock TextWrapping="Wrap"><Run Text="✎ Editing '" /><Run Text="{Binding PresetName}" FontWeight="SemiBold" /><Run Text="'" /></TextBlock>
                    </Border>
                    <TextBox Header="Preset name" Text="{Binding PresetName, Mode=TwoWay}" MaxLength="80" />
                    <Border Style="{StaticResource FluxCardBorderStyle}">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="Back" Command="{Binding BackCommand}" />
            <Button Content="Next" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" />
            <Button
                Content="{Binding SaveButtonText}"
                Style="{StaticResource AccentButtonStyle}"
                Command="{Binding CreateCommand}"
                IsEnabled="{Binding CanCreate}"
                Visibility="{Binding CurrentStep, Converter={StaticResource StepTwoConverter}}" />
        </StackPanel>
    </Grid>
</Page>
