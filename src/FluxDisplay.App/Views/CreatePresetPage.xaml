<Page
    x:Class="FluxDisplay.App.Views.CreatePresetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluxDisplay.App.Controls"
    xmlns:models="using:FluxDisplay.App.Models"
    x:Name="RootPage">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:StepperHeader />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepZeroConverter}}">
                    <HyperlinkButton Content="Identify displays" Command="{Binding IdentifyCommand}" />
                    <ItemsRepeater ItemsSource="{Binding Monitors}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="280" MinItemHeight="140" MinColumnSpacing="12" MinRowSpacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:MonitorOption">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0"
                                    Command="{Binding DataContext.SelectMonitorCommand, ElementName=RootPage}"
                                    CommandParameter="{Binding}">
                                    <controls:MonitorPickerCard DataContext="{Binding}" />
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <StackPanel Spacing="12" Visibility="{Binding CurrentStep, Converter={StaticResource StepOneConverter}}">
                    <ComboBox
                        Header="Resolution"
                        MinWidth="280"
                        ItemsSource="{Binding Resolutions}"
                        SelectedItem="{Binding SelectedResolution, Mode=TwoWay}" />
                    <ComboBox
                        Header="Refresh rate"
                        MinWidth="280"
                        ItemsSource="{Binding RefreshRates}"
                        SelectedItem="{Binding SelectedRefreshRate, Mode=TwoWay}" />
                    <ComboBox
                        Header="Scaling"
                        MinWidth="280"
                        ItemsSource="{Binding ScaleOptions}"
                        SelectedItem="{Binding ScalePercent, Mode=TwoWay}" />
                    <TextBox Header="DPI" IsReadOnly="True" Text="{Binding CurrentDpi}" />
                </StackPanel>

                <StackPanel Spacing="12" Visibility="{Binding CurrentStep, Converter={StaticResource StepTwoConverter}}">
                    <TextBox Header="Preset name" Text="{Binding PresetName, Mode=TwoWay}" MaxLength="80" />
                    <Border Style="{StaticResource FluxCardBorderStyle}">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="Back" Command="{Binding BackCommand}" />
            <Button Content="Next" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" />
            <Button
                Content="Create preset"
                Style="{StaticResource AccentButtonStyle}"
                Command="{Binding CreateCommand}"
                IsEnabled="{Binding CanCreate}"
                Visibility="{Binding CurrentStep, Converter={StaticResource StepTwoConverter}}" />
        </StackPanel>
    </Grid>
</Page>
