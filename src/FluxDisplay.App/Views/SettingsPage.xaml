<Page
    x:Class="FluxDisplay.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource FluxPageTitleStyle}" />
            <ToggleSwitch Header="Start with Windows" IsOn="{Binding StartWithWindows, Mode=TwoWay}" />
            <ToggleSwitch Header="Start minimized" IsOn="{Binding StartMinimized, Mode=TwoWay}" />
            <ToggleSwitch Header="Confirm before apply" IsOn="{Binding ConfirmBeforeApply, Mode=TwoWay}" />
            <NumberBox
                Header="Identify overlay (seconds)"
                Minimum="1"
                Maximum="10"
                SpinButtonPlacementMode="Inline"
                Value="{Binding IdentifyOverlaySeconds, Mode=TwoWay}" />
            <ComboBox
                Header="Theme"
                MinWidth="220"
                ItemsSource="{Binding Themes}"
                SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                DisplayMemberPath="Label" />
            <Border Style="{StaticResource FluxCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Updates" FontWeight="SemiBold" />
                    <ComboBox
                        Header="Check for updates"
                        MinWidth="280"
                        ItemsSource="{Binding UpdateModes}"
                        SelectedItem="{Binding SelectedUpdateMode, Mode=TwoWay}"
                        DisplayMemberPath="Label" />
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Content="Check now" Command="{Binding CheckUpdatesCommand}" />
                        <TextBlock
                            Text="{Binding UpdateStatus}"
                            Style="{StaticResource FluxMutedTextStyle}"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FluxCardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="About" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource FluxMutedTextStyle}"><Run Text="Version " /><Run Text="{Binding Version}" /></TextBlock>
                    <HyperlinkButton Content="GitHub" NavigateUri="{Binding GitHubUri}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
